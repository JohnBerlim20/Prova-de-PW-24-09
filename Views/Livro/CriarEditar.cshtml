@model Livro
@{
    var criando = ViewBag.TipoTela == "Criar";
    ViewData["Title"] = criando ? "Novo livro" : "Editar livro";
}

<div>
    <span class="page-kicker">Acervo</span>
    <h1 class="page-title">@(criando ? "Novo livro" : "Editar livro")</h1>
    <p class="page-description">
        @(criando ? "Preencha os dados abaixo para adicionar um livro ao catálogo." : "Atualize os dados do livro e mantenha o catálogo organizado.")
    </p>
</div>

<section class="surface form-panel">
    <div class="form-heading">
        <div>
            <h2>Informações do livro</h2>
            <p>Os campos abaixo correspondem ao registro armazenado no acervo.</p>
        </div>
    </div>

    <form asp-controller="Livro"
          asp-action="@(criando ? "Criar" : "Editar")"
          method="POST">
        <input type="hidden" asp-for="Id" />

        <div class="form-grid">
            <div class="form-field full">
                <label asp-for="Titulo" class="form-label">Título</label>
                <input type="text" asp-for="Titulo" class="form-control" placeholder="Ex.: Dom Casmurro" />
            </div>

            <div class="form-field">
                <label asp-for="ISBN" class="form-label">ISBN</label>
                <input type="text" asp-for="ISBN" class="form-control" placeholder="Informe o ISBN" />
            </div>

            <div class="form-field">
                <label asp-for="Autor" class="form-label">Autor</label>
                <input type="text" asp-for="Autor" class="form-control" placeholder="Nome do autor" />
            </div>

            <div class="form-field">
                <label asp-for="Editora" class="form-label">Editora</label>
                <input type="text" asp-for="Editora" class="form-control" placeholder="Nome da editora" />
            </div>

            <div class="form-field">
                <label asp-for="AnoPublicacao" class="form-label">Ano de publicação</label>
                <input type="number" asp-for="AnoPublicacao" class="form-control" placeholder="Ex.: 1899" />
            </div>
        </div>

        <div class="form-actions">
            <a class="btn btn-secondary" asp-controller="Livro" asp-action="Index">
                Voltar ao acervo
            </a>

            <div class="actions-right">
                <button type="submit" class="btn btn-primary">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 4h11l3 3v13H5z" />
                        <path d="M8 4v5h8V4M8 20v-7h8v7" />
                    </svg>
                    @(criando ? "Salvar livro" : "Salvar alterações")
                </button>
            </div>
        </div>
    </form>
</section>
